# Copy to .env and fill in:  cp .env.example .env
# Every setting is optional; the values below are the defaults unless noted.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# OpenRouteService API key (required for /api/route/). Free key: https://openrouteservice.org
ORS_API_KEY=

# Redis cache. Leave empty to use the in-process cache (no Redis needed).
# Example: redis://127.0.0.1:6379/1
REDIS_URL=

# Logging level for the routing and fuel loggers
LOG_LEVEL=INFO

# Vehicle assumptions
VEHICLE_RANGE_MILES=500
VEHICLE_MPG=10
REFUEL_LOWER_PERCENT=0.70
MAX_STATION_DETOUR_MILES=30
